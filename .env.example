LLM_ENABLED=false
# Set production when deployed behind HTTPS to enable Secure login cookies.
ENVIRONMENT=development
# Optional email delivery for password recovery. Local setup codes use scripts.account_recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25
LLM_MAX_OUTPUT_TOKENS=4000
LLM_FAILURE_MODE=fallback
# In Render, also set your existing DATABASE_URL and CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000,https://timeblind-frontend.onrender.com
